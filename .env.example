# Sitenin canlı adresi (sitemap, canonical, JSON-LD için)
NEXT_PUBLIC_SITE_URL=https://seravit.com.tr

# Alt dizinde yayın (GitHub Pages: "/seravit"). Kök alan adında boş bırakın.
NEXT_PUBLIC_BASE_PATH=

# Form talepleri (teklif/randevu/bayi/iletişim) bu adrese JSON POST edilir
# (Formspree, Make, n8n, Google Apps Script…). Boşsa talep WhatsApp mesajı olarak açılır.
NEXT_PUBLIC_LEAD_ENDPOINT=
